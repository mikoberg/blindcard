# Copy to ingest/.env (never commit the real file).

# Postgres connection string used by the ingest job.
# Supabase: Project settings > Database > Connection string (session pooler).
DATABASE_URL=

# Contact shown in the scraper User-Agent (a project URL or a dedicated address).
# Required for every command that fetches pages. There is deliberately no default.
SCRAPER_CONTACT=

# Optional overrides
# CACHE_DIR=.cache/html
# REQUEST_INTERVAL_SECONDS=1.0
# LOG_LEVEL=INFO

# Only for DB integration tests (a throwaway database, never production, never the live project).
# TEST_DATABASE_URL=

# YouTube Data API v3 key (read-only; lists the UFC channel videos). Never commit a real value.
YOUTUBE_API_KEY=

# The production database (session pooler URL), only for the one-off load of the live project.
# PROD_DATABASE_URL=
