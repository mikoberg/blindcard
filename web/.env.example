# Copy to web/.env.local (gitignored). Use the DEV Supabase project first.
# Both values are public by design (anon key), but still keep them out of chat and commits.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used for absolute URLs (sitemap, Open Graph). Local default shown.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
